"""Offline-Test V14 (Rechenwerkzeug RW-v1, Ollama tool calling). Ohne Ollama: requests.post wird ersetzt.
Start (aus ~/RAG): python skripte/evaluation/teste_v14_offline.py"""
import sys as _sys, pathlib as _pl, json
_sys.path.insert(0, str(next(p for p in _pl.Path(__file__).resolve().parents if (p / "lernassistent").is_dir()) / "lernassistent")); import pfadsetup  # noqa: E402,F401
import rag_pipeline as rpl

ok = fail = 0
def check(name, cond):
    global ok, fail
    ok += bool(cond); fail += (not cond)
    print(("PASS " if cond else "FAIL ") + name)

# --- 1. Werkzeug selbst
t, w = rpl._rw_rechne({"ausdruck": "500 * (0.5 / (2*pi*1000/60))**2"})
check("V14 Werkzeug: F62-Rechnung 0,0114", w is not None and abs(w - 0.011399) < 1e-5 and t == "0.0113986")
t, w = rpl._rw_rechne({"ausdruck": "J0 + J1 * (1/10)^2", "werte": {"J0": 0.02, "J1": "1,5"}})
check("V14 Werkzeug: Namen aus 'werte', ^ und Dezimalkomma -> 0,035", w is not None and abs(w - 0.035) < 1e-12)
t, w = rpl._rw_rechne('{"ausdruck": "sqrt(3) * 400 * 16 * cos(36.87)"}')
check("V14 Werkzeug: Argumente als JSON-Text, Winkel in Grad", w is not None and abs(w - 8868.1) < 1)
t, w = rpl._rw_rechne({"ausdruck": "1,5 mm + 2 * 0,25 mm"})
check("V14 Werkzeug: Einheiten werden ignoriert", w is not None and abs(w - 2.0) < 1e-12)
t, w = rpl._rw_rechne({"ausdruck": "__import__('os').system('ls')"})
check("V14 Werkzeug: kein Code, nur Rechenausdrücke", w is None and t.startswith("Fehler"))
t, w = rpl._rw_rechne({"ausdruck": "x * 2"})
check("V14 Werkzeug: unbekannter Name -> Fehlermeldung an das Modell", w is None and "nicht auswertbar" in t)

# --- 2. Ablauf mit simuliertem /api/chat
class R:
    def __init__(self, daten): self.daten = daten
    def raise_for_status(self): pass
    def json(self): return self.daten
ENDE = ("STATUS: BEANTWORTET\nLÖSUNG: Das Ersatzträgheitsmoment beträgt 0,0114 kg·m². Begründung: ω = 2 · π · 1000/60 s⁻¹ = 104,7 s⁻¹; "
        "J_e = 500 kg · (0,5 / 104,7)² = 0,0114 kg·m².\nÜBERLEGUNG: x\nHINWEIS: Wie hängen Winkelgeschwindigkeit und Drehzahl zusammen?")
gesendet = []
def post_chat(url, json=None, timeout=None):
    gesendet.append((url, json))
    if url.endswith("/api/chat"):
        n_tool = sum(1 for m in json["messages"] if m["role"] == "tool")
        if n_tool == 0:
            return R({"message": {"role": "assistant", "content": "", "tool_calls": [
                {"function": {"name": "rechne", "arguments": {"ausdruck": "2*pi*1000/60"}}}]}})
        if n_tool == 1:
            return R({"message": {"role": "assistant", "content": "", "tool_calls": [
                {"function": {"name": "rechne", "arguments": {"ausdruck": "500*(0.5/104.72)**2"}}}]}})
        return R({"message": {"role": "assistant", "content": ENDE}})
    return R({"response": "STATUS: BEANTWORTET\nLÖSUNG: normal\nÜBERLEGUNG: x\nHINWEIS: h"})
alt = rpl.requests.post, rpl.RECHENWERKZEUG_VERSION, rpl.SCAFFOLDING_VERSION
FRAGE = "Eine Last von 500 kg bewegt sich mit 0,5 m/s geradlinig; der Motor dreht mit 1000 1/min. Welches Ersatzträgheitsmoment hat die Last an der Motorwelle?"
try:
    rpl.requests.post = post_chat
    rpl.SCAFFOLDING_VERSION = "G-v5"
    rpl.RECHENWERKZEUG_VERSION = "RW-v1"
    erg = {}
    roh = rpl.frage_llm_rechnend("PROMPT", FRAGE, erg)
    check("V14 Ablauf: Endantwort nach zwei Werkzeugaufrufen", roh == ENDE and erg["werkzeug"] == "RW-v1 genutzt, 2 Aufrufe")
    letzte = gesendet[-1][1]
    check("V14 Ablauf: Werkzeugergebnisse gehen an das Modell zurück (104.72, 0.0113986)",
          [m["content"] for m in letzte["messages"] if m["role"] == "tool"] == ["104.72", "0.0113986"])
    check("V14 Ablauf: Hinweis auf das Werkzeug im Prompt, think aus, T=0/seed", "Werkzeug „rechne“" in letzte["messages"][0]["content"]
          and letzte["think"] is False and letzte["options"]["temperature"] == 0 and letzte["options"]["seed"] == 42)
    check("V14 Ablauf: Protokoll der Aufrufe", [p[0] for p in erg["werkzeug_protokoll"]] == ["2*pi*1000/60", "500*(0.5/104.72)**2"])
    erg = {}
    rpl.frage_llm_rechnend("PROMPT", "Was ist Remanenz?", erg)
    check("V14 keine Rechenfrage: normaler Aufruf, kein Werkzeug", gesendet[-1][0].endswith("/api/generate") and "werkzeug" not in erg)
    rpl.RECHENWERKZEUG_VERSION = ""
    erg = {}
    rpl.frage_llm_rechnend("PROMPT", FRAGE, erg)
    check("V14 RW aus: normaler Aufruf", gesendet[-1][0].endswith("/api/generate") and "werkzeug" not in erg)
    rpl.RECHENWERKZEUG_VERSION = "RW-v1"
    def post_400(url, json=None, timeout=None):
        if url.endswith("/api/chat"):
            raise rpl.requests.exceptions.HTTPError("400 Client Error: model does not support tools")
        return R({"response": "NORMAL"})
    rpl.requests.post = post_400
    erg = {}
    check("V14 Modell ohne tools -> Rückfall auf normalen Aufruf", rpl.frage_llm_rechnend("PROMPT", FRAGE, erg) == "NORMAL"
          and erg["werkzeug"].startswith("RW-v1 Rückfall") and erg["werkzeug_protokoll"][0][0] == "FEHLER")
    def post_endlos(url, json=None, timeout=None):
        return R({"message": {"role": "assistant", "content": "", "tool_calls": [{"function": {"name": "rechne", "arguments": {"ausdruck": "1+1"}}}]}}) \
            if url.endswith("/api/chat") else R({"response": "NORMAL"})
    rpl.requests.post = post_endlos
    erg = {}
    check("V14 Endlosschleife begrenzt -> Rückfall", rpl.frage_llm_rechnend("PROMPT", FRAGE, erg) == "NORMAL"
          and "mehr als" in erg["werkzeug_protokoll"][-1][1])
finally:
    rpl.requests.post, rpl.RECHENWERKZEUG_VERSION, rpl.SCAFFOLDING_VERSION = alt

# --- 3. Ohne LERNASSISTENT_RW ändert sich nichts
check("V14 Standard: RW aus", rpl.RECHENWERKZEUG_VERSION in ("", None) or rpl.RECHENWERKZEUG_VERSION == __import__("os").environ.get("LERNASSISTENT_RW"))

print(f"\n{ok} bestanden, {fail} fehlgeschlagen")
_sys.exit(1 if fail else 0)
