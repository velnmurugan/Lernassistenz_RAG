#!/usr/bin/env bash
# V14 Kurzlauf (ca. 1 h, nur Rechnen, nur Arm V14 = RP-v11 + Rechenwerkzeug RW-v1). Vergleich mit den vorhandenen V134-Ergebnissen.
# 1) Probe (1 Frage): nutzt das Modell das Werkzeug? Sonst Abbruch. 2) 22 N100-Rechenfragen. 3) 8 RV-Fragen, die in V134 falsch waren.
# Start (aus ~/RAG, pilot_rag, nur Ollama läuft):
#   bash skripte/evaluation/kurzlauf_v14.sh 2>&1 | tee protokolle/kurzlauf_v14_$(date +%Y%m%d_%H%M).txt
cd "$(dirname "$0")/../.." || exit 1
mkdir -p protokolle
export PYTHONUNBUFFERED=1 LERNASSISTENT_RP=RP-v11 LERNASSISTENT_G=G-v5 LERNASSISTENT_FS=FS-v3 LERNASSISTENT_CTX=8192 LERNASSISTENT_RW=RW-v1
python skripte/evaluation/teste_v14_offline.py | tail -1
echo "=== Probe $(date +%H:%M) ==="
rm -f evaluationsdaten/rechen_varianten_V14K-PROBE.csv
python skripte/evaluation/teste_rechen_varianten.py V14K-PROBE --nur R12 2>&1 | tail -3
python - <<'PY' || { echo "ABBRUCH: Werkzeug wird nicht genutzt (siehe oben). Ergebnis bitte an Claude schicken."; exit 1; }
import csv, sys; csv.field_size_limit(10**9)
x = list(csv.DictReader(open("evaluationsdaten/rechen_varianten_V14K-PROBE.csv", encoding="utf-8")))[0]
print("Werkzeug:", x["werkzeug"], "| Aufrufe:", x["werkzeug_protokoll"][:500])
sys.exit(0 if "genutzt" in x["werkzeug"] and not x["werkzeug"].endswith(" 0 Aufrufe") else 1)
PY
echo; echo "=== N100-Rechenfragen (22) $(date +%H:%M) ==="
rm -f evaluationsdaten/rechen_varianten_N100R-V14K.csv
python skripte/evaluation/teste_rechen_varianten.py N100R-V14K --fragen daten/testfragen/n100_rechnung_v1.csv 2>&1 | tee protokolle/rechen_varianten_N100R-V14K.txt
echo; echo "=== RV, 8 in V134 falsche Fragen $(date +%H:%M) ==="
rm -f evaluationsdaten/rechen_varianten_V14K.csv
python skripte/evaluation/teste_rechen_varianten.py V14K --nur R01,R02,R04,R12,R14,R17,R19,R20 2>&1 | tee protokolle/rechen_varianten_V14K.txt
python -m zipfile -c V14K_ergebnisse.zip evaluationsdaten/rechen_varianten_{V14K-PROBE,N100R-V14K,V14K}.csv \
  protokolle/rechen_varianten_{N100R-V14K,V14K}.txt $(ls -t protokolle/kurzlauf_v14_*.txt 2>/dev/null | head -1) \
  && cp V14K_ergebnisse.zip "/mnt/c/Users/Vel Narayanasamy/Downloads/" 2>/dev/null
echo "Ergebnis-Zip: ~/RAG/V14K_ergebnisse.zip (auch in Windows-Downloads)"
echo "=== fertig $(date +%H:%M) ==="
